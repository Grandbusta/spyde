{
  "name": "@grandbusta/spyde",
  "version": "0.3.0",
  "description": "Declarative, composable PDF layout on top of PDFKit, for Node and the browser. No headless browser.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grandbusta/spyde.git"
  },
  "homepage": "https://github.com/Grandbusta/spyde#readme",
  "bugs": {
    "url": "https://github.com/Grandbusta/spyde/issues"
  },
  "keywords": [
    "pdf",
    "pdfkit",
    "layout",
    "declarative",
    "invoice",
    "report",
    "node",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle",
    "bundle": "esbuild dist/index.browser.js --bundle --format=esm --platform=browser --minify --legal-comments=eof --outfile=dist/spyde.browser.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-out/test/",
    "clean": "rm -rf dist .test-out",
    "example": "tsc -p tsconfig.test.json && node .test-out/examples/invoice.js && node .test-out/examples/statement.js",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "preview": "tsc -p tsconfig.test.json && node .test-out/examples/preview/server.js",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview",
    "editor:dev": "npm run build && npm --prefix editor run dev",
    "editor:build": "npm run build && npm --prefix editor run build"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
